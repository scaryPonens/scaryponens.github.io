<mxfile host="Electron" version="32.6.1">
  <diagram id="harness-vs-bot" name="Harness vs Bot">
    <mxGraphModel dx="980" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left panel container: Claude Code Harness -->
        <mxCell id="left-frame" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;strokeWidth=1;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="420" height="325" as="geometry" />
        </mxCell>
        <mxCell id="left-title" value="&lt;b&gt;A. Session harness (Claude Code)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px;&quot;&gt;Your live presence holds the state and gates the shell.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="36" y="32" width="388" height="40" as="geometry" />
        </mxCell>

        <mxCell id="l-you" value="You watching an open terminal" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="85" y="84" width="290" height="42" as="geometry" />
        </mxCell>

        <mxCell id="l-chat" value="&lt;span style=&quot;background-color:#ffffff;padding:2px 6px;&quot;&gt;&lt;b&gt;State in scrollback&lt;/b&gt; · auto-compacts &amp;amp; dies&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillStyle=cross-hatch;fillColor=#888888;hachureGap=8;hachureAngle=-45;sketch=0;jiggle=0;strokeColor=#1c1a17;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="148" width="340" height="48" as="geometry" />
        </mxCell>

        <mxCell id="l-shell" value="One implicit identity: &lt;b&gt;your shell&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;inherits every signed-in CLI, token &amp;amp; SSH key&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="65" y="218" width="330" height="48" as="geometry" />
        </mxCell>

        <mxCell id="l-stop" value="Stops existing when session closes" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="90" y="288" width="280" height="38" as="geometry" />
        </mxCell>

        <mxCell id="le1" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="l-you" target="l-chat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le2" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="l-chat" target="l-shell">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le3" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="l-shell" target="l-stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Right panel container: Persistent Orca Bot -->
        <mxCell id="right-frame" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1c1a17;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="440" height="325" as="geometry" />
        </mxCell>
        <mxCell id="right-title" value="&lt;b&gt;B. Persistent Orca bot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px;&quot;&gt;Outlives the session; splits state and identity explicitly.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="486" y="32" width="408" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r-wake" value="You &lt;i&gt;or&lt;/i&gt; async event wake (PR, CI, chat)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c1a17;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="530" y="84" width="320" height="42" as="geometry" />
        </mxCell>

        <mxCell id="r-state" value="&lt;span style=&quot;padding:2px 6px;&quot;&gt;&lt;b&gt;Durable state:&lt;/b&gt; Items, MEMORY.md &amp;amp; GitHub&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillStyle=hatch;fillColor=#888888;hachureGap=8;hachureAngle=-45;sketch=0;jiggle=0;strokeColor=#1c1a17;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="515" y="148" width="350" height="48" as="geometry" />
        </mxCell>

        <mxCell id="r-rules" value="&lt;b&gt;SOUL.md&lt;/b&gt; gate · read &amp;amp; report before mutating" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=12;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="530" y="218" width="320" height="46" as="geometry" />
        </mxCell>

        <mxCell id="r-self" value="&lt;b&gt;Speaks as bot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;Slack &amp;amp; waking thread&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="492" y="286" width="192" height="42" as="geometry" />
        </mxCell>

        <mxCell id="r-owner" value="&lt;b&gt;Acts as you&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;gh, Linear &amp;amp; host CLIs&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#1c1a17;strokeWidth=1.25;fontFamily=Helvetica;fontSize=11.5;fontColor=#1c1a17;" vertex="1" parent="1">
          <mxGeometry x="698" y="286" width="194" height="42" as="geometry" />
        </mxCell>

        <mxCell id="re1" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.5;" edge="1" parent="1" source="r-wake" target="r-state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="r-state" target="r-rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="r-rules" target="r-self">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" style="endArrow=block;endFill=1;strokeColor=#1c1a17;strokeWidth=1.25;" edge="1" parent="1" source="r-rules" target="r-owner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
