        <mxCell id="left-frame" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;strokeWidth=1;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
